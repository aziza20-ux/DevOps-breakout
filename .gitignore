# ===== Compiled files =====
# Compiled Java classes are rebuilt every time, so no need to track them
*.class

# ===== Build output folders =====
# Maven puts built files in target/
target/
# Gradle puts built files in build/ and keeps a cache in .gradle/
build/
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# ===== Packaged files =====
# JAR/WAR files are build results, not source code
*.jar
*.war
*.ear
# Keep the Maven wrapper jar, since it helps teammates build without installing Maven
!.mvn/wrapper/maven-wrapper.jar

# ===== Logs =====
# Log files change constantly and may hold private data
*.log
logs/

# ===== Secrets and environment settings =====
# Never upload passwords, API keys, or database credentials
.env
*.env
# Local config for your own machine, not shared with the team
application-local.properties
application-local.yml
application-dev.properties
application-dev.yml

# ===== IDE files =====
# Each teammate's editor settings are personal
# IntelliJ IDEA
.idea/
*.iml
*.iws
out/
# Eclipse / Spring Tool Suite (STS)
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache/
bin/
# VS Code
.vscode/
# NetBeans
nbproject/
nbbuild/
dist/

# ===== Operating system files =====
# Hidden junk files created by Windows and Mac
.DS_Store
Thumbs.db

# ===== Temporary files =====
*.tmp
*.bak
*.swp
